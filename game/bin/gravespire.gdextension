[configuration]

entry_symbol = "gravespire_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libgravespire.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgravespire.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libgravespire.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libgravespire.android.template_release.arm64.so"

